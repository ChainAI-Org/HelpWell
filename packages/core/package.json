{
  "name": "@helpwell/core",
  "version": "0.1.0",
  "description": "The HelpWell engine: schema, migrations, search, the support agent, and the HTTP API.",
  "license": "AGPL-3.0-only",
  "author": "Workado, LLC",
  "homepage": "https://helpwell.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChainAI-Org/helpwell.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/ChainAI-Org/helpwell/issues"
  },
  "keywords": [
    "helpwell",
    "help desk",
    "customer support",
    "ai agent",
    "documentation",
    "knowledge base",
    "self-hosted",
    "open source",
    "postgres",
    "drizzle",
    "rag",
    "search",
    "intercom alternative",
    "zendesk alternative",
    "help scout alternative",
    "freshdesk alternative",
    "crisp alternative",
    "front alternative",
    "tidio alternative",
    "drift alternative",
    "livechat alternative",
    "tawk.to alternative",
    "zoho desk alternative",
    "hubspot service hub alternative",
    "gorgias alternative",
    "kustomer alternative",
    "chatwoot alternative",
    "zammad alternative",
    "intercom fin alternative",
    "ada alternative",
    "canny alternative",
    "document360 alternative",
    "appcues alternative"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "import": "./dist/db.js",
      "require": "./dist/db.cjs"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js",
      "require": "./dist/settings.cjs"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "import": "./dist/content.js",
      "require": "./dist/content.cjs"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js",
      "require": "./dist/search.cjs"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js",
      "require": "./dist/agent.cjs"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "require": "./dist/api.cjs"
    },
    "./repos": {
      "types": "./dist/repos.d.ts",
      "import": "./dist/repos.js",
      "require": "./dist/repos.cjs"
    },
    "./import": {
      "types": "./dist/import.d.ts",
      "import": "./dist/import.js",
      "require": "./dist/import.cjs"
    },
    "./setup-prompt": {
      "types": "./dist/setup-prompt.d.ts",
      "import": "./dist/setup-prompt.js",
      "require": "./dist/setup-prompt.cjs"
    },
    "./changelog": {
      "types": "./dist/changelog.d.ts",
      "import": "./dist/changelog.js",
      "require": "./dist/changelog.cjs"
    },
    "./docs": {
      "types": "./dist/docs.d.ts",
      "import": "./dist/docs.js",
      "require": "./dist/docs.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@helpwell/tokens": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "jose": "^5.9.0",
    "zod": "^3.24.0",
    "@electric-sql/pglite": "^0.2.17"
  },
  "peerDependencies": {
    "postgres": ">=3.4.0"
  },
  "peerDependenciesMeta": {
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "postgres": "^3.4.5",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
