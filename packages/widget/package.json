{
  "name": "@helpwell/widget",
  "version": "0.1.0",
  "description": "The HelpWell support widget: a Shadow DOM chat, help centre, changelog and roadmap that mounts on any page.",
  "license": "AGPL-3.0-only",
  "author": "Workado, LLC",
  "homepage": "https://helpwell.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChainAI-Org/HelpWell.git",
    "directory": "packages/widget"
  },
  "bugs": {
    "url": "https://github.com/ChainAI-Org/HelpWell/issues"
  },
  "keywords": [
    "helpwell",
    "help desk",
    "customer support",
    "ai agent",
    "documentation",
    "knowledge base",
    "self-hosted",
    "open source",
    "chat widget",
    "shadow dom",
    "changelog",
    "roadmap",
    "in-app help",
    "intercom alternative",
    "zendesk alternative",
    "help scout alternative",
    "freshdesk alternative",
    "crisp alternative",
    "front alternative",
    "tidio alternative",
    "drift alternative",
    "livechat alternative",
    "tawk.to alternative",
    "zoho desk alternative",
    "hubspot service hub alternative",
    "gorgias alternative",
    "kustomer alternative",
    "chatwoot alternative",
    "zammad alternative",
    "intercom fin alternative",
    "ada alternative",
    "canny alternative",
    "document360 alternative",
    "appcues alternative"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@helpwell/tokens": "workspace:*",
    "@helpwell/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "happy-dom": "^15.11.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
