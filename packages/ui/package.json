{
  "name": "@helpwell/ui",
  "version": "0.1.0",
  "description": "Server-rendered HTML primitives shared by the HelpWell help centre and dashboard.",
  "license": "AGPL-3.0-only",
  "author": "Workado, LLC",
  "homepage": "https://helpwell.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChainAI-Org/helpwell.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/ChainAI-Org/helpwell/issues"
  },
  "keywords": [
    "helpwell",
    "help desk",
    "customer support",
    "ai agent",
    "documentation",
    "knowledge base",
    "self-hosted",
    "open source",
    "html",
    "templates"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "import": "./dist/fonts.js",
      "require": "./dist/fonts.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@helpwell/tokens": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
