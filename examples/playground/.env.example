# Copy to .env.local. Every value here is optional — the playground runs with
# none of them set.

# Shared secret for signed identify tokens. The Ridgeline server signs a token
# with it (lib/identity.ts) and HelpWell verifies it (POST /api/helpwell/identify),
# which is what stops a browser claiming to be somebody else.
#
# Without this the playground falls back to a hard-coded development secret so
# the "Sign in as Ada" path still works. A real install must set it to a random
# value and keep it out of the repo:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HELPWELL_IDENTITY_SECRET=

# OpenRouter key for the support agent. Leave it empty and the agent answers
# from a short script instead (@helpwell/core's FakeModel) — search, citations,
# conversations and gaps all still work, only the wording is canned.
OPENROUTER_API_KEY=

# Other sites allowed to run the widget against this API, comma-separated
# origins, e.g. https://www.ridgeline.example. Leave empty when the widget is
# only on this app. A widget on another site keeps its visitor in the
# X-HelpWell-Visitor header, because browsers block the API's cookie there.
HELPWELL_CORS_ORIGINS=

# Where HelpWell keeps its tables. Defaults to pglite://memory: real Postgres
# compiled to WASM, no server to install, gone when the process exits.
#
#   pglite://./.helpwell/db       keep it on disk between restarts
#   postgres://user:pass@host/db  your own database; HelpWell lives in a
#                                 `helpwell` schema inside it
HELPWELL_DATABASE_URL=
