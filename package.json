{
  "name": "helpwell-monorepo",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "dev": "pnpm --filter @helpwell/playground dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "typecheck": "pnpm -r --filter \"./packages/**\" typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "clean": "rimraf packages/*/dist packages/*/*.tsbuildinfo",
    "screenshots": "node scripts/screenshots.mjs",
    "readme": "node scripts/readme.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@electric-sql/pglite": "^0.2.17",
    "@helpwell/core": "workspace:*",
    "@helpwell/dashboard": "workspace:*",
    "@helpwell/helpcenter": "workspace:*",
    "@helpwell/tokens": "workspace:*",
    "@helpwell/ui": "workspace:*",
    "@helpwell/widget": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
